{
  "name": "@aeratic/pagetailor",
  "version": "0.6.0",
  "description": "Pages as data: declarative YAML pages, typed data catalog, per-user overrides, validated for AI agents. Renders with json-render.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pagetailor": "bin/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.jsx"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "server-driven-ui",
    "generative-ui",
    "declarative-ui",
    "json-render",
    "yaml",
    "personalization",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeratic/pagetailor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "esbuild": "^0.25.0",
    "yaml": "^2.6.0",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-dom": ">=19.2.3"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "test": "node --no-deprecation --import ./test/jsx-loader.mjs --test test/"
  }
}
